OPENAI_API_KEY=
GEMINI_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TO=raymond87tan@gmail.com
# Monday-Friday schedule is interpreted in Asia/Kuala_Lumpur.
# Daily reports should use the latest available extended-hours data after the U.S. close.
# Live alerts should use live/intraday data during U.S. regular hours and 24-hour/extended-hours data outside regular hours.
SEND_EMAIL=0
ANALYSIS_SYMBOLS=NOK,AMD,NVDA,INTC,SNDK,SKHY
MAX_ANALYSIS_SYMBOLS=20
# Legacy fallback if ANALYSIS_SYMBOLS is not configured:
FIXED_SIX_SYMBOLS=NOK,AMD,NVDA,INTC,SNDK,SKHY
AI_PRIMARY_PROVIDER=openai
AI_FALLBACK_PROVIDER=gemini
DATA_PROVIDER=yfinance
NEWS_PROVIDER=yfinance
LIVE_DATA_PROVIDER=yfinance
DAILY_REPORT_CRON_UTC=0 23 * * 1-5
MIN_SETUP_SCORE=70
MIN_RELATIVE_VOLUME=1.5
DAY_TRADE_THRESHOLD=75
SHORT_THRESHOLD=70
LONG_THRESHOLD=70
DYNAMIC_COUNT=3
DAY_TRADE_GAP_THRESHOLD=3.0
DAY_TRADE_RVOL_THRESHOLD=1.5
DAY_TRADE_MIN_SETUP_SCORE=65
MORNING_REPORT_TIMEZONE=Asia/Kuala_Lumpur
LIVE_MARKET_TIMEZONE=America/New_York
LIVE_MARKET_OPEN=09:30
LIVE_MARKET_CLOSE=16:00
V4_OPENING_START=09:30
V4_OPENING_END=10:00
V4_OPENING_MIN_RVOL=1.20
V4_OPENING_MIN_SETUP_SCORE=75
V4_NORMAL_MIN_RVOL=1.50
V4_NORMAL_MIN_SETUP_SCORE=70
V4_OPENING_RANGE_MINUTES=30
V4_MAX_TRIGGER_AGE_MINUTES=30
TELEGRAM_ENABLED=0
TELEGRAM_BOT_TOKEN=
# Local development can use TELEGRAM_CHAT_ID. GitHub Actions uses separate secrets:
# TELEGRAM_STOCK_CHAT_ID for Live Stock Alerts
# TELEGRAM_EVENT_CHAT_ID for Live Event Alerts
TELEGRAM_CHAT_ID=
DATABASE_ENABLED=1
DATABASE_URL=
